{
  "info": {
    "_postman_id": "137-request-service",
    "name": "Request Service (ثبت درخواست)",
    "description": "Request Service API for the 137 municipality system. Base URL: https://apiweb-137request.sabzevar.ir (dev: http://127.0.0.1:5050)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:5050" },
    { "key": "apiKey", "value": "dev-internal-key-137" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
          }
        },
        {
          "name": "GET /api/health",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/health", "host": ["{{baseUrl}}"], "path": ["api", "health"] }
          }
        }
      ]
    },
    {
      "name": "Create Request",
      "item": [
        {
          "name": "POST PhoneCall via API key",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('Has trackingCode', () => pm.expect(body.trackingCode).to.match(/^\\d{5}$/));",
                  "pm.environment.set('trackingCode', body.trackingCode);",
                  "pm.environment.set('requestId', body.requestId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-Api-Key", "value": "{{apiKey}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"channel\": \"PhoneCall\",\n  \"citizen\": {\n    \"nationalCode\": \"1111111111\",\n    \"firstName\": \"علی\",\n    \"lastName\": \"احمدی\",\n    \"phoneNumber\": \"09150000000\"\n  },\n  \"description\": \"گزارش شبکه آبرسانی\",\n  \"fileIds\": [\n    \"11111111-1111-1111-1111-111111111111\"\n  ]\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/requests", "host": ["{{baseUrl}}"], "path": ["api", "v1", "requests"] }
          }
        },
        {
          "name": "POST CitizenMobileApp via bearer",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer <sso-token>" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"channel\": \"CitizenMobileApp\",\n  \"citizen\": {\n    \"nationalCode\": \"1111111111\"\n  },\n  \"description\": \"کولاک و شکستگی جداول\",\n  \"location\": {\n    \"lat\": 36.21,\n    \"lng\": 57.66\n  }\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/requests", "host": ["{{baseUrl}}"], "path": ["api", "v1", "requests"] }
          }
        },
        {
          "name": "POST InternalService via API key",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-Api-Key", "value": "{{apiKey}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"channel\": \"InternalService\",\n  \"description\": \"درخواست از سرویس داخلی\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/requests", "host": ["{{baseUrl}}"], "path": ["api", "v1", "requests"] }
          }
        }
      ]
    },
    {
      "name": "Reserved (Phase 2) - expect 501",
      "item": [
        { "name": "GET /api/v1/requests/{id}", "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/v1/requests/{{requestId}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "requests", "{{requestId}}"] } } },
        { "name": "GET by tracking code", "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/v1/requests/by-tracking-code/{{trackingCode}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "requests", "by-tracking-code", "{{trackingCode}}"] } } },
        { "name": "GET search / cartable", "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/v1/requests?status=New&from=2026-01-01&to=2026-12-31", "host": ["{{baseUrl}}"], "query": [ { "key": "status", "value": "New" }, { "key": "from", "value": "2026-01-01" }, { "key": "to", "value": "2026-12-31" } ], "path": ["api", "v1", "requests"] } } },
        { "name": "PUT /{id}/status", "request": { "method": "PUT", "header": [ { "key": "Content-Type", "value": "application/json" } ], "body": { "mode": "raw", "raw": "{\n  \"status\": \"InProgress\"\n}" }, "url": { "raw": "{{baseUrl}}/api/v1/requests/{{requestId}}/status", "host": ["{{baseUrl}}"], "path": ["api", "v1", "requests", "{{requestId}}", "status"] } } },
        { "name": "PUT /{id}/refer", "request": { "method": "PUT", "header": [ { "key": "Content-Type", "value": "application/json" } ], "body": { "mode": "raw", "raw": "{\n  \"groupId\": \"GRP-0712\"\n}" }, "url": { "raw": "{{baseUrl}}/api/v1/requests/{{requestId}}/refer", "host": ["{{baseUrl}}"], "path": ["api", "v1", "requests", "{{requestId}}", "refer"] } } }
      ]
    }
  ]
}